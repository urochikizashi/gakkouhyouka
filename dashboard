<!DOCTYPE html>
<html>
<head>
    <title>学校評価ダッシュボード (プロトタイプ)</title>
    <link rel="stylesheet" href="style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <header>
        <h1>学校評価ダッシュボード</h1>
        <p>保護者向けサマリー</p>
    </header>

    <main>
        <section class="chart-container">
            <h2>全体評価スコア</h2>
            <canvas id="overallScoreChart"></canvas>
        </section>

        <section class="chart-container">
            <h2>肯定的回答の割合</h2>
            <canvas id="positiveRatioChart"></canvas>
        </section>
    </main>

    <footer>
        <p>© 2024 学校名</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
